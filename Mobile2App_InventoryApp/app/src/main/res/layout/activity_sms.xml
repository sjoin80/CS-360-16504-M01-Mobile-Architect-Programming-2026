<?xml version="1.0" encoding="utf-8"?>
<!--
    SMS Permission Screen
    Allows user to enable SMS notifications and shows status based on permission.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white"
    android:gravity="center_horizontal">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS Notifications"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Status Message -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable SMS notifications for low inventory alerts."
        android:layout_marginBottom="24dp" />

    <!-- Enable Permission Button -->
    <Button
        android:id="@+id/enableSmsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable SMS Notifications" />

    <!-- Test SMS Button -->
    <Button
        android:id="@+id/testSmsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Test SMS"
        android:layout_marginTop="12dp" />

</LinearLayout>